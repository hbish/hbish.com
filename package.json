{
  "name": "hbish.com",
  "description": "Ben Shi's Blog",
  "version": "1.0.0",
  "author": "Ben Shi <ben@hbish.com>",
  "bugs": {
    "url": "https://github.com/hbish/hbish.com/issues"
  },
  "dependencies": {
    "@deckdeckgo/highlight-code": "^3.6.0",
    "gatsby": "^4.11.1",
    "gatsby-plugin-feed": "^4.11.1",
    "gatsby-plugin-image": "^2.11.1",
    "gatsby-plugin-manifest": "^4.11.1",
    "gatsby-plugin-offline": "^5.11.1",
    "gatsby-plugin-react-helmet": "^5.11.0",
    "gatsby-plugin-react-svg": "^3.1.0",
    "gatsby-plugin-sass": "^5.11.1",
    "gatsby-plugin-sharp": "^4.11.1",
    "gatsby-plugin-sitemap": "^5.11.1",
    "gatsby-remark-autolink-headers": "^5.11.1",
    "gatsby-remark-copy-linked-files": "^5.11.0",
    "gatsby-remark-highlight-code": "^3.2.0",
    "gatsby-remark-images": "^6.11.1",
    "gatsby-remark-responsive-iframe": "^5.11.0",
    "gatsby-remark-smartypants": "^5.11.0",
    "gatsby-source-filesystem": "^4.11.1",
    "gatsby-transformer-remark": "^5.11.1",
    "gatsby-transformer-sharp": "^4.11.0",
    "gatsby-transformer-sqip": "^4.11.1",
    "lodash": "^4.17.21",
    "milligram-scss": "^1.4.1",
    "node-sass": "^7.0.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-helmet": "^6.1.0",
    "rimraf": "^3.0.2",
    "typeface-cardo": "^1.1.13",
    "typeface-playfair-display": "^1.1.13"
  },
  "devDependencies": {
    "babel-eslint": "^9.0.0",
    "babel-preset-env": "^1.7.0",
    "eslint": "^8.12.0",
    "eslint-plugin-react": "^7.29.4",
    "gh-pages": "^3.2.3",
    "prettier": "^2.6.2"
  },
  "homepage": "https://hbish.com",
  "keywords": [
    "hbish",
    "gatsby",
    "blog"
  ],
  "license": "MIT",
  "main": "n/a",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hbish/hbish.com.git"
  },
  "scripts": {
    "develop": "npm run clean && gatsby develop",
    "build": "npm run clean && gatsby build",
    "clean": "rimraf .cache public",
    "lint": "./node_modules/.bin/eslint --ext .js,.jsx --ignore-pattern public .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --trailing-comma es5 --no-semi --single-quote --write 'src/**/*.js' 'src/**/*.md'",
    "fix-semi": "eslint --quiet --ignore-pattern node_modules --ignore-pattern public --parser babel-eslint --no-eslintrc --rule '{\"semi\": [2, \"never\"], \"no-extra-semi\": [2]}' --fix gatsby-node.js"
  }
}
